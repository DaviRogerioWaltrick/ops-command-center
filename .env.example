# --- v1 (works without any of these) ---
# The app runs entirely on fixture data (see lib/connectors/*/fixtures.ts)
# and rule-based ranking until you fill these in. Nothing below is required
# to run `npm run dev`.

# Powers the AI ranking reasoning (lib/ranking/engine.ts) and inferred-
# dependency detection (lib/dependencies.ts). Without it, both fall back to
# their deterministic rule-based behavior — the app still works, just with
# template reasoning instead of model-authored narrative.
ANTHROPIC_API_KEY=
# Optional override; defaults to claude-sonnet-5.
AI_INSIGHTS_MODEL=

# --- Development phase only (see README) ---
# Do not provision this until you're intentionally starting the development
# phase — see lib/db/schema.ts and lib/db/client.ts. Nothing reads this
# variable yet.
DATABASE_URL=

# --- Live connectors (replaces the fixture data in lib/connectors/*) ---
# Not read by any code yet — placeholders for when a real workspace/org is
# connected instead of lib/connectors/clickup/fixtures.ts and
# lib/connectors/salesforce/fixtures.ts.
CLICKUP_API_TOKEN=
SALESFORCE_INSTANCE_URL=
SALESFORCE_ACCESS_TOKEN=

# --- TypeSafe (Jev) probabilistic ranking ---
# Not read by any code yet. Evaluate conservatively on fixtures only; cost
# structure is unknown. Server-side only, never expose to the browser.
TYPESAFE_API_KEY=
# "probabilistic" ranks with Jev (needs TYPESAFE_API_KEY; costs money). "probabilistic-demo"
# uses a local stand-in with invented numbers, for building the UI (free, not Jev output).
# Unset keeps the current Claude ranking. Optional cap on items the model is asked about per run (default 150); more open items than that are ranked below by exact facts only.
RANKING_MODE=
JEV_MAX_ITEMS=
